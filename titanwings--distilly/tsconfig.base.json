{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "paths": {
      "@distilly/adapters": ["./packages/adapters/src/index.ts"],
      "@distilly/bindings": ["./packages/bindings/src/index.ts"],
      "@distilly/cli/preview": ["./packages/cli/src/preview.ts"],
      "@distilly/engine/preview": ["./packages/engine/src/preview.ts"],
      "@distilly/mcp": ["./packages/mcp/src/index.ts"],
      "@distilly/mcp/internal/schema": ["./packages/mcp/src/internal-schema.ts"],
      "@distilly/mcp/stdio": ["./packages/mcp/src/stdio.ts"],
      "@distilly/panel/server": ["./packages/panel/src/server.ts"],
      "@distilly/panel/web": ["./packages/panel/src/web.ts"],
      "@distilly/protocol": ["./packages/protocol/src/index.ts"],
      "@distilly/runtime/preview": ["./packages/runtime/src/preview.ts"],
      "distilly": ["./packages/distilly/src/index.ts"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
